# 用户级单元不能由包替用户 enable（要在那个用户的会话里做），所以只提示。
_openuuyc_service_note() {
  cat <<'NOTE'

>>> 使用以下命令在登录时自动启动：
    systemctl --user enable openuuyc.service
NOTE
}

# 虚拟显示器辅助程序平时不跑：它是个系统服务，只在被控端真的要给主控加一块虚拟屏
# 时才由套接字拉起。装完不开启也一切照旧，只是诊断页里那一行会显示「服务未启用」。
_openuuyc_virtual_display_note() {
  cat <<'NOTE'

>>> 要使用虚拟显示器功能，请启用：
    sudo systemctl enable --now openuuyc-vkms.socket
NOTE
}

post_install() {
  _openuuyc_service_note
  _openuuyc_virtual_display_note
}

post_upgrade() {
  _openuuyc_service_note
  _openuuyc_virtual_display_note
}
