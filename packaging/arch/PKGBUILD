# Maintainer: Clansty <i@clansty.com>
#
# OpenUUYC 的 Arch 包（openuuyc-clansty），默认跟随 GitHub 上 clansty 开发分支。
#
# 从远程分支构建：
#   cd packaging/arch && makepkg -f
#
# 从本地工作树构建（开发时推荐：直接在工作树上增量编译，不拷贝源码、不重新拉依赖）：
#   ./packaging/arch/build.sh
# OPENUUYC_LOCAL_SRC / BUILDDIR / CARGO_TARGET_DIR / PKGDEST 由那个脚本摆好，见其 --help。
# 手动调用时留意 BUILDDIR 必须在仓库之外：makepkg 会在其中建 src/ 与 pkg/，
# 而 pkg/ 被 makepkg 设成 0111，摆在仓库里会让 cargo 扫描包目录时报
# "Permission denied (os error 13)"，把整个构建打断。

# 能力名。上游 DoyoDia/openuuyc-linux 的 AUR 包（openuuyc-bin / openuuyc-git）装的
# 是同一套文件，和本包不能共存，因此三者 provides 同一个名字、再互相 conflicts。
_pkgname=openuuyc
pkgname=$_pkgname-clansty
# 基准版本来自 Cargo.toml 的 [package].version，pkgver() 会再读一次：正好在 tag 上就是
# 这个版本号，tag 之后再提交才追加 .r<提交数>.g<hash>（数的是离最近那个 tag 的提交数）。
# 版本号里的 `-`（-clansty 这种预发布后缀）要换成 `.`：pacman 的 pkgver 里不能有连字符。
pkgver=1.0.2.beta.5.clansty1
pkgrel=1
pkgdesc='UU 远程（UU Remote）协议的第三方 Rust 客户端：远控别人，或被本机远控'
arch=('x86_64')
url='https://github.com/clansty/farwing'
# 仓库整体不是 SPDX 标准许可，而是自定义的「版权与许可声明」（见 LICENSE）。
# 按 SPDX 的说法用 LicenseRef- 前缀；既然不是常见许可，原文必须装到
# /usr/share/licenses/$pkgname/ 下（namcap 会检查，装 custom 它会报 E）。
license=('LicenseRef-OpenUUYC')

# 直接链接（readelf -d 的 NEEDED）或运行时 dlopen 的库，逐条注明来源。
depends=(
  # readelf -d 的直接 NEEDED
  'alsa-lib'          # libasound.so.2，cpal 走 ALSA
  'ffmpeg'            # libavcodec.so.63 / libavutil.so.61 / libavfilter.so.12（系统 FFmpeg，不是内建）
  'gcc-libs'          # libstdc++.so.6（NetEq 的 C++ 部分）、libgcc_s.so.1
  'glibc'             # libc.so.6 / libm.so.6
  'libva'             # libva.so.2 / libva-drm.so.2，VA-API 硬件解码
  'libxcb'            # libxcb.so.1
  # 运行时 dlopen
  'fuse3'             # fusermount3，剪贴板/拖放粘贴远端文件时的只读 FUSE 挂载
  'libglvnd'          # libEGL.so.1（及 libGLESv2），Vulkan 不可用时的 OpenGL 渲染回退
  'libx11'            # libX11.so.6 / libX11-xcb.so.1，winit 的 X11 后端
  'libxcursor'        # libXcursor.so.1，X11 下加载鼠标指针主题
  'libxi'             # libXi.so.6，winit 的 XInput2（绝对坐标/多屏）
  'libxkbcommon'      # libxkbcommon.so.0，键盘布局与按键映射
  'libxkbcommon-x11'  # libxkbcommon-x11.so.0，X11 下的 xkbcommon
  'noto-fonts-cjk'    # /usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc，界面中文靠它（内置字体无 CJK 字形）
  'wayland'           # libwayland-client.so.0 / libwayland-egl.so.1，Wayland 会话
)

makedepends=(
  'clang'    # libclang：ffmpeg-sys-next 与 vendored cros-libva 用 bindgen 生成绑定
  'cmake'    # opusic-sys 用 cmake 从源码构建 libopus
  'git'      # VCS 源（$pkgname 的 source 是 git+https）
  'nasm'     # AV1 软解与 H.264 的 x86 SIMD 汇编（nasm-rs）
  'pkgconf'  # alsa-sys / cros-libva / ffmpeg-sys-next / khronos-egl / wayland-sys / x11-dl 都靠它找库
  'rust'     # 同时提供 cargo（repo 里没有单独的 cargo 包）
)

# 只影响部分功能，缺了也能跑，但缺哪一项就少哪一块，因此都写清楚用途。
optdepends=(
  'vulkan-icd-loader: 首选渲染后端，缺失时回退 OpenGL'
  'mesa: VA-API 硬解与渲染'
  'nvidia-utils: NVENC 硬编、NvFBC 采集与 Vulkan'
  'libpulse: 采集桌面声音'
  'libpipewire: Wayland/XDG Portal 采集桌面画面'
  'gnome-keyring: 保存登录态'
  'kwallet: 保存登录态'
  'ethtool: 远程开机时检查网卡的魔术包唤醒状态'
  'hwdata: 获取显卡名称'
  'gnome-shell-extension-appindicator: GNOME 下显示托盘图标'
  'glib2: 获取文件图标'
  'librsvg: 拼接拖放预览图'
)

# 带上版本是为了让「依赖 openuuyc>=x」的包能对上；不带也不影响互斥。
provides=("$_pkgname=$pkgver")
# 自己的 provides 名也列进 conflicts：pacman 只拿 conflicts 去比对「别的」包，
# 所以这不会自冲突，却正好把上游那两个 provides openuuyc 的包一并挡掉。
# 显式点名是因为它们有可能被改得不 provides 这个名字（pacman -Si 也看得更明白）。
conflicts=("$_pkgname" "${_pkgname}-bin" "${_pkgname}-git")
install="$pkgname.install"
# 关闭 makepkg 的 LTO：Cargo.toml 的 release profile 已经调好 lto/codegen-units，
# 混入 makepkg 的 -flto 只会让 NetEq 的 C++ 对象与 rustc 链接参数打起来。
# 同时跳过 debug 分包：release profile 的 strip="debuginfo" 之后二进制里已无 .debug_* 段，
# 但 makepkg 仍会用 objcopy --only-keep-debug 抠出一个几十 MB 的空 stub 包，纯属白产。
options=('!debug' '!lto')

if [[ -n ${OPENUUYC_LOCAL_SRC:-} ]]; then
  source=()
  sha256sums=()
else
  source=("$pkgname::git+https://github.com/clansty/farwing.git#branch=clansty")
  sha256sums=('SKIP')
fi

# 远程构建时源码在 $srcdir/$pkgname；本地构建时直接用工作树本身。
_src_dir() {
  if [[ -n ${OPENUUYC_LOCAL_SRC:-} ]]; then
    printf '%s' "${OPENUUYC_LOCAL_SRC%/}"
  else
    printf '%s' "$srcdir/$pkgname"
  fi
}

pkgver() {
  cd "$(_src_dir)"
  local base count hash
  base=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  # `-` 是 PKGBUILD 里 pkgver 与 pkgrel 的分隔符，不能出现在版本号里。
  base=${base//-/.}
  hash=$(git rev-parse --short=7 HEAD 2>/dev/null || echo nogit)
  # 发布用的包从 tag 上打，版本号保持干净；分支往前走了才在版本号里带上它离
  # 最近那个 tag 有多少个提交（`rev-list --count HEAD` 数的是整个仓库的提交总数，
  # 那样发布版也会拖着一串 .r<几百>，不是这里想要的语义）。
  if git describe --exact-match --tags HEAD >/dev/null 2>&1; then
    printf '%s' "$base"
  else
    count=$(git rev-list --count "$(git describe --tags --abbrev=0)"..HEAD 2>/dev/null || echo 0)
    printf '%s.r%s.g%s' "$base" "$count" "$hash"
  fi
}

build() {
  cd "$(_src_dir)"
  # 这个包是要发给别人装的，编译器标志不能跟着本机走：makepkg.conf 里 CFLAGS 一旦是
  # -march=native，cc-rs / cmake 编出来的内建 C 代码（静态 libopus、NetEq）就只认构建机
  # 的 CPU，在别人的 v4 机器上照样 SIGILL。
  export CFLAGS="-O2 -march=x86-64-v3 -mtune=generic"
  export CXXFLAGS="$CFLAGS"
  # 同理，而且必须在这里覆盖：/etc/makepkg.conf.d/rust.conf 把 RUSTFLAGS 钉成
  # `-C opt-level=3 -C target-cpu=native`，那是在 makepkg 启动时 export 的，外面
  # （build.sh 或命令行）传什么都拦不住，只有 build() 里再 export 一次才盖得住。
  export RUSTFLAGS="-C target-cpu=x86-64-v3"
  # 与 .github/workflows/linux-deb.yml 一致；CARGO_TARGET_DIR 由调用方决定，
  # 不在这里写死，本地构建才能复用工作树自己的 target/。
  cargo build --release --locked --bin OpenUUYC
  # 虚拟显示器辅助程序是独立的 crate（自己的 workspace 和 Cargo.lock），但产物指到
  # 同一个 target/，打包时只认一处。
  local target_dir
  target_dir=$(realpath "${CARGO_TARGET_DIR:-target}")
  ( cd crates/vkms && CARGO_TARGET_DIR="$target_dir" cargo build --release --locked )
}

package() {
  cd "$(_src_dir)"
  local target_dir=${CARGO_TARGET_DIR:-target}

  install -Dm755 "$target_dir/release/OpenUUYC" "$pkgdir/usr/bin/OpenUUYC"

  # 桌面入口：Exec=OpenUUYC 与上面的 /usr/bin/OpenUUYC 大小写一致，
  # Icon=openuuyc 与下面的 hicolor 文件名一致，因此原文件不用改。
  install -Dm644 packaging/linux/openuuyc.desktop \
    "$pkgdir/usr/share/applications/openuuyc.desktop"
  install -Dm644 assets/icon-256.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/openuuyc.png"

  # 被控端键鼠经 /dev/uinput 注入，规则本身只做 uaccess 授权（见 openuuyc-clansty.install）。
  install -Dm644 packaging/linux/70-openuuyc-uinput.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-openuuyc-uinput.rules"

  # 登录自启的被控服务。跟着 graphical-session.target 走，所以用户要自己
  # `systemctl --user enable openuuyc.service`；装包时不能替用户 enable。
  install -Dm644 packaging/linux/openuuyc.service \
    "$pkgdir/usr/lib/systemd/user/openuuyc.service"

  # 虚拟显示器辅助程序：凭空多一块显示器要写 configfs，只有 root 能写，所以它是个
  # 独立的系统服务，平时不跑，第一次用到时由套接字拉起（见 openuuyc-clansty.install）。
  install -Dm755 "$target_dir/release/openuuyc-vkms" \
    "$pkgdir/usr/bin/openuuyc-vkms"
  install -Dm644 packaging/linux/openuuyc-vkms.socket \
    "$pkgdir/usr/lib/systemd/system/openuuyc-vkms.socket"
  install -Dm644 packaging/linux/openuuyc-vkms.service \
    "$pkgdir/usr/lib/systemd/system/openuuyc-vkms.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES"
  install -d "$pkgdir/usr/share/licenses/$pkgname/third-party"
  install -m644 assets/licenses/*.txt licenses/openh264-algorithms.txt \
    "$pkgdir/usr/share/licenses/$pkgname/third-party/"
}
