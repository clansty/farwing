pkgbase = openuuyc-clansty
	pkgdesc = UU 远程（UU Remote）协议的第三方 Rust 客户端：远控别人，或被本机远控
	pkgver = 1.0.2.beta.3.clansty
	pkgrel = 1
	url = https://github.com/clansty/farwing
	install = openuuyc-clansty.install
	arch = x86_64
	license = LicenseRef-OpenUUYC
	makedepends = clang
	makedepends = cmake
	makedepends = git
	makedepends = nasm
	makedepends = pkgconf
	makedepends = rust
	depends = alsa-lib
	depends = ffmpeg
	depends = gcc-libs
	depends = glibc
	depends = libva
	depends = libxcb
	depends = fuse3
	depends = libglvnd
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = noto-fonts-cjk
	depends = wayland
	optdepends = vulkan-icd-loader: 首选渲染后端（Vulkan）；缺失时回退 libglvnd 的 OpenGL
	optdepends = mesa: Intel/AMD/软件 Vulkan 驱动（VA-API 硬解与渲染都需要厂商驱动）
	optdepends = nvidia-utils: NVIDIA 驱动；NVENC 硬编、NvFBC 采集与 Vulkan 都靠它
	optdepends = libpulse: 被控端用 PulseAudio 客户端接口采集桌面声音（PipeWire 的音源也可）
	optdepends = libpipewire: Wayland/XDG 门户画面采集（wlroots screencopy 与 X11 采集不需要）
	optdepends = gnome-keyring: 用 Secret Service 保存登录态（与 kwallet 二选一，缺了两者无法保存登录）
	optdepends = kwallet: 用 Secret Service 保存登录态（与 gnome-keyring 二选一）
	optdepends = ethtool: 远程开机时检查网卡的魔术包唤醒状态
	optdepends = hwdata: 用 pci.ids 给上报的显卡取名（/usr/share/hwdata/pci.ids）
	optdepends = gnome-shell-extension-appindicator: GNOME 下显示托盘图标（KDE/Xfce 等自带托盘）
	provides = openuuyc=1.0.2.beta.3.clansty
	conflicts = openuuyc
	conflicts = openuuyc-bin
	conflicts = openuuyc-git
	options = !lto
	source = openuuyc-clansty::git+https://github.com/clansty/farwing.git#branch=clansty
	sha256sums = SKIP

pkgname = openuuyc-clansty
