# The host role's virtual keyboard and pointer. /dev/uinput is where they are
# created from, and the devices they become are what the session has to read:
# without the second rule the compositor cannot open them, and the input simply
# goes nowhere.
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="OpenUUYC *", TAG+="uaccess"
